{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/inactifs",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/cron/process-notifications",
      "schedule": "*/5 * * * *"
    }
  ]
}